<!--
  故障报修页 - WXML
  包含：货柜信息、故障类型选择、问题描述、联系方式、提交按钮
  成功状态显示成功提示
-->

<view class="repair-container">
  <!-- 提交成功状态 -->
  <block wx:if="{{isSuccess}}">
    <view class="success-container">
      <view class="success-icon-wrapper">
        <text class="success-icon">✓</text>
      </view>
      <view class="success-title">提交成功！</view>
      <view class="success-desc">我们将在10分钟内联系您</view>
    </view>
  </block>

  <!-- 表单状态 -->
  <block wx:else>
    <scroll-view class="repair-scroll" scroll-y="true">
      <!-- 货柜信息卡片 -->
      <!-- 对应：bg-card p-4 mb-4 shadow-[0_2px_8px_0_rgba(0,0,0,0.06)] -->
      <view class="section-card">
        <view class="section-title">当前货柜信息</view>
        <view class="info-list">
          <!-- 货柜编号 -->
          <view class="info-row">
            <text class="info-label">货柜编号</text>
            <text class="info-value">{{cabinetInfo.id}}</text>
          </view>
          <!-- 所在位置 -->
          <view class="info-row info-row-start">
            <text class="info-label">所在位置</text>
            <text class="info-value info-value-right">{{cabinetInfo.location}}</text>
          </view>
          <!-- 最近订单 -->
          <view class="info-row">
            <text class="info-label">最近订单</text>
            <text class="info-value info-value-primary">{{cabinetInfo.recentOrder}}</text>
          </view>
        </view>
      </view>

      <!-- 故障类型选择 -->
      <!-- 对应：bg-card p-4 mb-4 shadow-[0_2px_8px_0_rgba(0,0,0,0.06)] -->
      <view class="section-card">
        <view class="section-title">故障类型</view>
        <view class="option-list">
          <button
            wx:for="{{issueTypes}}"
            wx:key="*this"
            class="option-btn {{selectedIssue === item ? 'option-btn-selected' : ''}}"
            data-issue="{{item}}"
            bindtap="handleSelectIssue"
          >
            {{item}}
          </button>
        </view>
      </view>

      <!-- 问题描述 -->
      <!-- 对应：bg-card p-4 mb-4 shadow-[0_2px_8px_0_rgba(0,0,0,0.06)] -->
      <view class="section-card">
        <view class="section-title">问题描述</view>
        <textarea
          class="desc-textarea"
          value="{{description}}"
          placeholder="请详细描述您遇到的问题，以便我们更好地为您服务..."
          placeholder-class="textarea-placeholder"
          maxlength="500"
          bindinput="handleDescInput"
        />
      </view>

      <!-- 联系方式 -->
      <!-- 对应：bg-card p-4 mb-4 shadow-[0_2px_8px_0_rgba(0,0,0,0.06)] -->
      <view class="section-card">
        <view class="section-title">联系方式</view>
        <input
          class="contact-input"
          type="number"
          value="{{contact}}"
          placeholder="请输入手机号码"
          placeholder-class="input-placeholder"
          maxlength="11"
          bindinput="handleContactInput"
        />
      </view>

      <!-- 提交按钮区域 -->
      <view class="submit-area">
        <button
          class="submit-btn {{isSubmitting ? 'submit-btn-disabled' : ''}}"
          disabled="{{isSubmitting}}"
          bindtap="handleSubmit"
        >
          <block wx:if="{{isSubmitting}}">
            <view class="submitting-content">
              <view class="spinner"></view>
              <text>提交中...</text>
            </view>
          </block>
          <block wx:else>
            <text>提交报修</text>
          </block>
        </button>
      </view>
    </scroll-view>
  </block>
</view>
