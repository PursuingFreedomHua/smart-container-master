<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.fuguang.kefu.mapper.KnowledgeDocumentMapper">

    <resultMap id="BaseResultMap" type="cn.fuguang.kefu.pojo.entity.KnowledgeDocumentEntity">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="chunk_count" property="chunkCount"/>
        <result column="category" property="category"/>
        <result column="remarks" property="remarks"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.fuguang.kefu.pojo.entity.KnowledgeDocumentEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO knowledge_document (title, content, status, chunk_count, category, remarks)
        VALUES (#{title}, #{content}, #{status}, #{chunkCount}, #{category}, #{remarks})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM knowledge_document WHERE id = #{id}
    </select>

    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT * FROM knowledge_document
        ORDER BY create_time DESC
        LIMIT #{offset}, #{size}
    </select>

    <update id="updateStatus">
        UPDATE knowledge_document
        SET status = #{status}, chunk_count = #{chunkCount}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM knowledge_document WHERE id = #{id}
    </delete>

    <select id="count" resultType="int">
        SELECT COUNT(1) FROM knowledge_document
    </select>

</mapper>
