<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.fuguang.kefu.mapper.PromptTemplateMapper">

    <resultMap id="BaseResultMap" type="cn.fuguang.kefu.pojo.entity.PromptTemplateEntity">
        <id column="id" property="id"/>
        <result column="template_code" property="templateCode"/>
        <result column="template_name" property="templateName"/>
        <result column="content" property="content"/>
        <result column="is_active" property="isActive"/>
        <result column="remarks" property="remarks"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.fuguang.kefu.pojo.entity.PromptTemplateEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO prompt_template (template_code, template_name, content, is_active, remarks)
        VALUES (#{templateCode}, #{templateName}, #{content}, #{isActive}, #{remarks})
    </insert>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM prompt_template WHERE template_code = #{templateCode} AND is_active = 1
    </select>

    <select id="selectAllActive" resultMap="BaseResultMap">
        SELECT * FROM prompt_template WHERE is_active = 1
        ORDER BY create_time DESC
    </select>

    <update id="updateById" parameterType="cn.fuguang.kefu.pojo.entity.PromptTemplateEntity">
        UPDATE prompt_template
        <set>
            <if test="templateCode != null">template_code = #{templateCode},</if>
            <if test="templateName != null">template_name = #{templateName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM prompt_template WHERE id = #{id}
    </delete>

</mapper>
